# Database Configuration
DATABASE_URL=postgresql://username:password@your-aurora-endpoint:5432/your-database

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# API Configuration
API_V1_STR=/api/v1
PROJECT_NAME=MDSpecialist API

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Logging
LOG_LEVEL=INFO

# Pinecone Configuration
PINECONE_API_KEY=your-pinecone-api-key-here

# LLM Configuration
# Both API keys are required as provider selection is now done via UI buttons
# OpenAI API Key
OPENAI_API_KEY=your-openai-api-key-here
# Google API Key
GOOGLE_API_KEY=your-google-api-key-here
# Optional: Override default model (e.g., "gpt-4o", "gemini-1.5-flash")
# LLM_MODEL=
